{
  "name": "codemirror-typst",
  "version": "0.1.2",
  "description": "Typst language support for CodeMirror 6: a hand-written incremental Lezer parser, syntax highlighting, folding and indentation. Pure TypeScript, no WASM.",
  "keywords": [
    "codemirror",
    "codemirror6",
    "lezer",
    "typst",
    "syntax-highlighting",
    "editor",
    "language"
  ],
  "license": "MIT",
  "author": "Ahdeyyy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahdeyyy/codemirror-typst.git"
  },
  "homepage": "https://github.com/Ahdeyyy/codemirror-typst#readme",
  "bugs": {
    "url": "https://github.com/Ahdeyyy/codemirror-typst/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run check-types && bun test && bun run build"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.0.0",
    "@lezer/common": "^1.2.0",
    "@lezer/highlight": "^1.2.0"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@types/bun": "^1.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
